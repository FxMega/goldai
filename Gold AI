def is_red_news_now():
  try:
    url = "https://nfs.faireconomy.media/ff_calendar_thisweek.xml"
    xml_data = urllib.request.urlopen(url, timeout=10).read()
    root = ET.fromstring(xml_data)
    now_utc = datetime.datetime.utcnow()
    
    for event in root.findall('event'):
      currency = event.find('country').text if event.find('country') is not None else ""
      impact = event.find('impact').text if event.find('impact') is not None else ""
      
      if currency.strip() not in ["USD", "ALL"]: continue
      if impact.strip() != "High": continue # ONLY RED FOLDER
      
      date_str = event.find('date').text
      time_str = event.find('time').text
      title = event.find('title').text if event.find('title') is not None else "RED NEWS"
      
      try:
        if "All Day" in time_str or "Tentative" in time_str or time_str.strip() == "":
          continue
        dt = datetime.datetime.strptime(f"{date_str} {time_str}", "%m-%d-%Y %I:%M%p")
        dt_utc = dt + datetime.timedelta(hours=4) # EDT to UTC
        diff_minutes = (now_utc - dt_utc).total_seconds() / 60
        
        # BLOCK WINDOW: 60 mins before to 60 mins after
        if -60 <= diff_minutes <= 60:
          print(f"🚫 FF RED NEWS: {currency} {title} at {dt_utc} UTC - BLOCKED")
          return True
      except Exception as e:
        continue
    return False
  except Exception as e:
    print(f"FF Check Error {e} - Trading Allowed")
    return False

